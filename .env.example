# Copiar a .env (no se sube a git). En la EC2 lo genera CloudFormation.
# Local: "postgres" es el contenedor de docker-compose.override.yml.
DB_NAME=pedidos360_orders
DB_URL=jdbc:postgresql://postgres:5432/pedidos360_orders
DB_USERNAME=pedidos360
DB_PASSWORD=cambiar-esta-clave

# Entra ID (opcionales: los defaults de application.yaml apuntan al tenant del proyecto).
# ENTRA_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0
# ENTRA_API_CLIENT_ID=<client-id-de-la-api>

# Local: catalog corre en otro compose y se alcanza por el host de Docker Desktop.
CATALOG_BASE_URL=http://host.docker.internal:8081
SERVICES_CONNECT_TIMEOUT=2s
SERVICES_READ_TIMEOUT=5s

# Local: docker-compose.rabbitmq.yml. En AWS: "ip-nodo1:5672,ip-nodo2:5672" con un usuario propio (no guest).
RABBIT_ADDRESSES=host.docker.internal:5672
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest
RABBIT_DECLARE_TOPOLOGY=true

# Vacío = sin CORS (el navegador llama al BFF, no a orders).
CORS_ALLOWED_ORIGINS=
